# in.test_mace.lmp - smoke test for a MACE (ML-IAP) model on a Pt/graphene/Nafion/water structure
# usage: lmp -in in.test_mace.lmp -var data path/to/data.lammps -var model path/to/model-mliap_lammps.pt
variable data  index /home/user/Documents/Programs/For_GIT/LAMMPS_MACE_degradation/structure_gen/structures/octahedron_019pt/data.lammps
variable model index /home/user/Documents/Programs/For_GIT/LAMMPS_MACE_degradation/MACE-LAMMPSV9.pt

units           metal
boundary        p p p
atom_style      atomic
atom_modify     map yes
newton          on

read_data       ${data}                 # types: 1 Pt, 2 C, 3 O, 4 H, 5 F, 6 S
pair_style      mliap unified ${model} 0
pair_coeff      * * Pt C O H F S

neighbor        1.0 bin
comm_modify     cutoff 9.5              # ghost range >= RDF cutoff (8.0) + skin; RDFs beyond the model cutoff need this
group           Pt type 1

# --- per-Pt contact counts (cutoffs in A: between 1st and 2nd shells / bonded) ---
compute         cnPtPt Pt coord/atom cutoff 3.3 1      # Pt-Pt neighbours
compute         cnPtC  Pt coord/atom cutoff 2.6 2      # Pt-C
compute         cnPtO  Pt coord/atom cutoff 2.7 3      # Pt-O (water/sulfonate/adsorbed)
compute         cnPtS  Pt coord/atom cutoff 3.6 6      # Pt...S (sulfonate-bound)
compute         nPtPt  Pt reduce ave c_cnPtPt          # mean Pt-Pt coordination number
compute         nPtC   Pt reduce sum c_cnPtC           # total Pt-C contacts
compute         nPtO   Pt reduce sum c_cnPtO
compute         nPtS   Pt reduce sum c_cnPtS

# --- RDFs: Pt-S, Pt-O, Pt-C ---
compute         rdf all rdf 100 1 6 1 3 1 2 cutoff 8.0
fix             rdfout all ave/time 5 20 100 c_rdf[*] file rdf_test.dat mode vector

thermo_style    custom step temp pe ke etotal fmax press c_nPtPt c_nPtC c_nPtO c_nPtS
thermo_modify   flush yes
thermo          10

# --- 1. single point at the initial structure ---
print           ">>> single point"
run             0
write_dump      all custom test_step0.lammpstrj id type x y z fx fy fz modify sort id

# --- 2. short relaxation ---
print           ">>> relax"
min_style       cg
minimize        1e-8 0.1 50 500

# --- 3. short NVT, 100 -> 300 K ---
print           ">>> short MD"
timestep        0.0005
velocity        all create 100.0 48291 dist gaussian mom yes rot yes
fix             nvt all nvt temp 100.0 300.0 0.05
run             200
write_data      test_final.data